# LÓGOS AI local desktop configuration.
# Copy to .env and edit only for your local machine. Do not commit .env.

# The backend intentionally binds to loopback by default. Networked operation
# remains unsupported until authentication and authorization are implemented.
PORT=3008

# Local model services
OLLAMA_BASE_URL=http://127.0.0.1:11434
UTILITY_MODEL=gemma2:2b
PYTHON_CMD=python

# Optional: keep persona image memory outside the repository.
# PERSONA_MEMORY_DIR=C:\\path\\to\\logos-persona-memory

# Development-only diagnostic endpoints. These must remain false in all
# distributable builds; the generic database console bypasses domain invariants.
ENABLE_DATABASE_ADMIN_API=false

# Agent dispatch can read and create files. Keep it disabled until the
# capability/approval system and authenticated network mode are implemented.
ENABLE_AGENT_API=false

# Starts a host-side process and is intentionally unavailable by default.
ENABLE_COMFYUI_LAUNCH_API=false

# Memory editing and wiping are destructive and remain disabled until the
# transactional memory store and authorization model are complete.
ENABLE_MEMORY_ADMIN_API=false

# Comma-separated browser origins permitted to call the local API. The backend
# binds to loopback; do not add LAN or public origins until networked mode is
# implemented and authenticated.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3008,http://localhost:3008

# RAG upload quota in bytes (20 MiB). The server accepts one file per request.
MAX_RAG_UPLOAD_BYTES=20971520
